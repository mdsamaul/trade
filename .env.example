# ==============================================================================
# QUOTEX AUTONOMOUS PAPER-TRADING AGENT - CONFIGURATION
# ==============================================================================

# AI Vision API Configuration (OpenAI, xAI Grok, OpenRouter, or Local Ollama)
# If left blank, the system automatically uses the internal Heuristic Computer-Vision engine.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# For xAI Grok Vision:
# OPENAI_BASE_URL=https://api.x.ai/v1
# OPENAI_MODEL=grok-vision-beta

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Paper-Trading Parameters
INITIAL_BALANCE=10000.0
DEFAULT_TRADE_AMOUNT=100.0
PAYOUT_RATE=0.85
CANDLE_TIMEFRAME_SECONDS=60

# Strategy Optimizer Initial Strictness (1 to 5)
# 1 = Lenient (60% min confidence)
# 2 = Balanced (70% min confidence)
# 3 = Selective (78% min confidence)
# 4 = High Strictness (84% min confidence)
# 5 = Sniper Strictness (90% min confidence)
DEFAULT_STRICTNESS=2

# Target Goal Settings
TARGET_ROLLING_WIN_RATE=0.80
ROLLING_WINDOW_SIZE=5
